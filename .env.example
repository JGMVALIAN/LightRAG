# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_rag
POSTGRES_USER=legal_rag_user
POSTGRES_PASSWORD=change_me_in_production

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=INFO

# LightRAG Configuration
LIGHTRAG_WORKING_DIR=./data/lightrag
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_SIZE=100
MAX_ASYNC=4
MAX_TOKENS=32000

# Spanish Legal Corpus
BOE_BASE_URL=https://www.boe.es
CENDOJ_BASE_URL=https://www.poderjudicial.es/search/indexAN.jsp

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
SENTRY_DSN=

# Security (ENS Compliance)
ENABLE_AUDIT_LOG=true
ENCRYPTION_KEY_PATH=/etc/legal-rag/keys/encryption.key
HSM_ENABLED=false
HSM_PKCS11_LIB=/usr/lib/softhsm/libsofthsm2.so

# Feature Flags
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
ENABLE_LEGAL_REASONING=true
ENABLE_CITATION_VALIDATION=true
ENABLE_TEMPORAL_ANALYSIS=true
